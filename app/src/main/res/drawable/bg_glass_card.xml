<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主玻璃体：顶部偏亮（克莱因蓝调）→ 底部沉入背景 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/surface_glass_top"
                android:endColor="@color/surface_glass_bottom" />
        </shape>
    </item>
    <!-- 顶部高光：模拟玻璃迎光反射 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#1CFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- 描边：更亮的边缘反光 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
